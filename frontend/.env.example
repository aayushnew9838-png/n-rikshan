# ---------------------------------------------------------------------------
# Nirikshan frontend - public configuration (safe for the browser bundle)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. No secrets belong here - everything in
# this file is baked into the browser bundle at build time.

# Base URL of the Nirikshan backend.
#   backend FastAPI      -> http://localhost:8000/api/v1
#   ML inference service -> http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Spline scene for the landing hero 3D scene.
# Must be a `.splinecode` URL (a `my.spline.design/...` share link is not
# loadable - open the scene in the Spline editor and publish to get one).
# When empty, a local animated atmospheric canvas fallback is used instead.
#
# Weather / atmosphere scene:
VITE_SPLINE_SCENE=https://prod.spline.design/RQIqa-DwqguUxbLh/scene.splinecode
#
# Alternative (keyboard weather tutorial) - publish it first to get a
# prod.spline.design/<id>/scene.splinecode URL:
# VITE_SPLINE_SCENE=https://prod.spline.design/<id>/scene.splinecode

# Force demo dataset: "true" forces demo, "false" forces live API only,
# unset (default) = live API, with an explicit "switch to demo" prompt if
# the backend is unreachable. Demo data is always badged as DEMO in the UI.
# VITE_DEMO_MODE=true
